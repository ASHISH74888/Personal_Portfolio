# Copy to `.env` for local dev; set the same keys in Vercel → Settings → Environment Variables.
# Server-side only — never prefixed with VITE_, so they stay out of the browser bundle.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=singhashish74888@gmail.com

# Gmail App Password (16 chars, 2FA required) — NOT your account password.
# Generate at https://myaccount.google.com/apppasswords
SMTP_PASS=

# Where form submissions land. Defaults to SMTP_USER if unset.
CONTACT_TO=singhashish74888@gmail.com

GEMINI_API_KEY=
